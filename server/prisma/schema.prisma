generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model billing_runs {
  id                   BigInt    @id @default(autoincrement())
  run_date             DateTime  @db.Date
  started_at           DateTime  @default(now()) @db.Timestamptz(6)
  finished_at          DateTime? @db.Timestamptz(6)
  invoices_created     Int       @default(0)
  subscriptions_closed Int       @default(0)
  errors               Json      @default("[]")
  triggered_by         BigInt?
  users                users?    @relation(fields: [triggered_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model discount_products {
  discount_id BigInt
  product_id  BigInt
  discounts   discounts @relation(fields: [discount_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([discount_id, product_id])
}

model discount_redemptions {
  id          BigInt    @id @default(autoincrement())
  discount_id BigInt
  invoice_id  BigInt
  amount      Decimal   @db.Decimal(12, 2)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  discounts   discounts @relation(fields: [discount_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([discount_id, invoice_id])
}

model discount_subscriptions {
  discount_id     BigInt
  subscription_id BigInt
  discounts       discounts     @relation(fields: [discount_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions   subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([discount_id, subscription_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discounts {
  id                     BigInt                   @id @default(autoincrement())
  name                   String
  type                   discount_type
  value                  Decimal                  @db.Decimal(12, 2)
  scope                  discount_scope
  min_purchase           Decimal                  @default(0) @db.Decimal(12, 2)
  min_quantity           Int                      @default(0)
  start_date             DateTime                 @db.Date
  end_date               DateTime?                @db.Date
  usage_limit            Int?
  used_count             Int                      @default(0)
  is_active              Boolean                  @default(true)
  created_by             BigInt
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  discount_products      discount_products[]
  discount_redemptions   discount_redemptions[]
  discount_subscriptions discount_subscriptions[]
  users                  users                    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_lines          invoice_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_lines {
  id              BigInt     @id @default(autoincrement())
  invoice_id      BigInt
  product_id      BigInt?
  description     String
  quantity        Int
  unit_price      Decimal    @db.Decimal(12, 2)
  line_subtotal   Decimal    @db.Decimal(12, 2)
  discount_id     BigInt?
  discount_amount Decimal    @default(0) @db.Decimal(12, 2)
  tax_name        String?
  tax_rate        Decimal    @default(0) @db.Decimal(5, 2)
  tax_amount      Decimal    @default(0) @db.Decimal(12, 2)
  line_total      Decimal    @db.Decimal(12, 2)
  discounts       discounts? @relation(fields: [discount_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices        invoices   @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_lines_inv")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id                   BigInt                 @id @default(autoincrement())
  number               String                 @unique @default(dbgenerated("('INV-'::text || lpad((nextval('invoice_number_seq'::regclass))::text, 6, '0'::text))"))
  subscription_id      BigInt
  customer_id          BigInt
  period_start         DateTime               @db.Date
  period_end           DateTime               @db.Date
  invoice_date         DateTime               @db.Date
  due_date             DateTime               @db.Date
  status               invoice_status         @default(DRAFT)
  subtotal             Decimal                @default(0) @db.Decimal(12, 2)
  discount_total       Decimal                @default(0) @db.Decimal(12, 2)
  tax_total            Decimal                @default(0) @db.Decimal(12, 2)
  total                Decimal                @default(0) @db.Decimal(12, 2)
  amount_paid          Decimal                @default(0) @db.Decimal(12, 2)
  bill_to_name         String
  bill_to_email        String
  bill_to_address      String?
  sent_at              DateTime?              @db.Timestamptz(6)
  confirmed_at         DateTime?              @db.Timestamptz(6)
  paid_at              DateTime?              @db.Timestamptz(6)
  cancelled_at         DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  discount_redemptions discount_redemptions[]
  invoice_lines        invoice_lines[]
  users                users                  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions        subscriptions          @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]

  @@unique([subscription_id, period_start], map: "uq_invoice_period")
  @@index([customer_id], map: "idx_invoices_customer")
  @@index([invoice_date], map: "idx_invoices_date")
  @@index([status, due_date], map: "idx_invoices_status_due")
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id          BigInt         @id @default(autoincrement())
  invoice_id  BigInt
  method      payment_method
  amount      Decimal        @db.Decimal(12, 2)
  paid_on     DateTime       @db.Date
  reference   String?
  note        String?
  recorded_by BigInt
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  invoices    invoices       @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users          @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_payments_invoice")
  @@index([paid_on], map: "idx_payments_paid_on")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plans {
  id                  BigInt                @id @default(autoincrement())
  name                String
  price               Decimal               @db.Decimal(12, 2)
  billing_period      billing_period
  min_quantity        Int                   @default(1)
  available_from      DateTime              @db.Date
  available_to        DateTime?             @db.Date
  auto_close          Boolean               @default(false)
  is_closable         Boolean               @default(true)
  is_pausable         Boolean               @default(false)
  is_renewable        Boolean               @default(true)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  quotation_templates quotation_templates[]
  subscriptions       subscriptions[]
}

model product_variants {
  id                       BigInt                     @id @default(autoincrement())
  product_id               BigInt
  attribute                String
  value                    String
  extra_price              Decimal                    @default(0) @db.Decimal(12, 2)
  products                 products                   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotation_template_lines quotation_template_lines[]
  subscription_lines       subscription_lines[]

  @@unique([product_id, attribute, value])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                       BigInt                     @id @default(autoincrement())
  name                     String
  type                     product_type               @default(SERVICE)
  sales_price              Decimal                    @db.Decimal(12, 2)
  cost_price               Decimal                    @default(0) @db.Decimal(12, 2)
  default_tax_id           BigInt?
  notes                    String?
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  discount_products        discount_products[]
  invoice_lines            invoice_lines[]
  product_variants         product_variants[]
  taxes                    taxes?                     @relation(fields: [default_tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotation_template_lines quotation_template_lines[]
  subscription_lines       subscription_lines[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotation_template_lines {
  id                  BigInt              @id @default(autoincrement())
  template_id         BigInt
  product_id          BigInt
  variant_id          BigInt?
  quantity            Int
  unit_price          Decimal?            @db.Decimal(12, 2)
  tax_id              BigInt?
  products            products            @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxes               taxes?              @relation(fields: [tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotation_templates quotation_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants    product_variants?   @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotation_templates {
  id                       BigInt                     @id @default(autoincrement())
  name                     String
  plan_id                  BigInt
  validity_days            Int
  payment_terms_days       Int                        @default(15)
  notes                    String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  quotation_template_lines quotation_template_lines[]
  plans                    plans                      @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions            subscriptions[]
}

model refresh_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscription_lines {
  id               BigInt            @id @default(autoincrement())
  subscription_id  BigInt
  product_id       BigInt
  variant_id       BigInt?
  quantity         Int
  unit_price       Decimal           @db.Decimal(12, 2)
  tax_id           BigInt?
  products         products          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions    subscriptions     @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxes            taxes?            @relation(fields: [tax_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id], map: "idx_sub_lines_sub")
}

model subscription_status_history {
  id              BigInt               @id @default(autoincrement())
  subscription_id BigInt
  from_status     subscription_status?
  to_status       subscription_status
  changed_by      BigInt?
  changed_at      DateTime             @default(now()) @db.Timestamptz(6)
  users           users?               @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions   subscriptions        @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscriptions {
  id                                     BigInt                        @id @default(autoincrement())
  number                                 String                        @unique @default(dbgenerated("('SUB-'::text || lpad((nextval('subscription_number_seq'::regclass))::text, 6, '0'::text))"))
  customer_id                            BigInt
  plan_id                                BigInt
  template_id                            BigInt?
  status                                 subscription_status           @default(DRAFT)
  start_date                             DateTime                      @db.Date
  expiry_date                            DateTime?                     @db.Date
  quotation_valid_until                  DateTime?                     @db.Date
  payment_terms_days                     Int                           @default(15)
  next_billing_date                      DateTime?                     @db.Date
  paused_at                              DateTime?                     @db.Date
  closed_at                              DateTime?                     @db.Timestamptz(6)
  notes                                  String?
  created_by                             BigInt?
  created_at                             DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime                      @default(now()) @db.Timestamptz(6)
  discount_subscriptions                 discount_subscriptions[]
  invoices                               invoices[]
  subscription_lines                     subscription_lines[]
  subscription_status_history            subscription_status_history[]
  users_subscriptions_created_byTousers  users?                        @relation("subscriptions_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_subscriptions_customer_idTousers users                         @relation("subscriptions_customer_idTousers", fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plans                                  plans                         @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotation_templates                    quotation_templates?          @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_subs_customer")
  @@index([status], map: "idx_subs_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model taxes {
  id                       BigInt                     @id @default(autoincrement())
  name                     String                     @unique
  rate                     Decimal                    @db.Decimal(5, 2)
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  products                 products[]
  quotation_template_lines quotation_template_lines[]
  subscription_lines       subscription_lines[]
}

model users {
  id                                             BigInt                        @id @default(autoincrement())
  email                                          String                        @unique @db.Citext
  password_hash                                  String
  full_name                                      String
  role                                           user_role                     @default(CUSTOMER)
  phone                                          String?
  company_name                                   String?
  address                                        String?
  gstin                                          String?
  is_active                                      Boolean                       @default(true)
  created_by                                     BigInt?
  created_at                                     DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime                      @default(now()) @db.Timestamptz(6)
  billing_runs                                   billing_runs[]
  discounts                                      discounts[]
  invoices                                       invoices[]
  password_reset_tokens                          password_reset_tokens[]
  payments                                       payments[]
  refresh_tokens                                 refresh_tokens[]
  subscription_status_history                    subscription_status_history[]
  subscriptions_subscriptions_created_byTousers  subscriptions[]               @relation("subscriptions_created_byTousers")
  subscriptions_subscriptions_customer_idTousers subscriptions[]               @relation("subscriptions_customer_idTousers")
  users                                          users?                        @relation("usersTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users                                    users[]                       @relation("usersTousers")
}

enum billing_period {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum discount_scope {
  PRODUCT
  SUBSCRIPTION
}

enum discount_type {
  FIXED
  PERCENTAGE
}

enum invoice_status {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum payment_method {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

enum product_type {
  SERVICE
  GOODS
  ADDON
}

enum subscription_status {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum user_role {
  ADMIN
  STAFF
  CUSTOMER
}
