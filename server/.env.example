DATABASE_URL=postgresql://app:app@localhost:5432/subs
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/subs_test
PORT=4000
TZ=UTC
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# used in reset-password links
APP_URL=http://localhost:5173
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Billing <billing@brightloop.test>"
AUTO_CONFIRM_INVOICES=false
BILLING_CRON="5 0 * * *"
# run the daily billing cron in this process (defaults to true only when NODE_ENV=production)
ENABLE_SCHEDULER=false
# requests per minute per IP on login / forgot-password / reset-password (5 in production; 30 for dev and the demo)
AUTH_RATE_LIMIT=5
